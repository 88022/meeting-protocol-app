# Базовый URL сайта (для ссылок в письмах и cookie)
APP_BASE_URL="https://pmassist.ru"

# База данных (SQLite на сервере)
DATABASE_URL="file:./prisma/dev.db"

# OpenAI (обязательно)
OPENAI_API_KEY="sk-..."

# Прокси для OpenAI (если нужен из РФ)
# HTTP_PROXY="http://user:pass@host:port"

# SMTP — отправка писем при одобрении заявки
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@pmassist.ru"
