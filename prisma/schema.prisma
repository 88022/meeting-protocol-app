datasource db {
  provider = "sqlite"
}
generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  firstName    String
  lastName     String
  passwordHash String?
  status       UserStatus @default(PENDING) // PENDING until approved and password set
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  accessRequests AccessRequest[]
  sessions       Session[]
  protocols      ProtocolLog[]
  approvedRequests AccessRequest[] @relation("ApprovedBy")
  passwordTokens   PasswordToken[]
}

enum UserStatus {
  PENDING   // запрос подан, ждёт одобрения
  INVITED   // одобрен, отправлено письмо для задания пароля
  ACTIVE    // полноценный доступ
  BLOCKED
}

model AccessRequest {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  createdAt   DateTime  @default(now())
  approvedAt  DateTime?
  approvedBy  User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedById Int?
  status      AccessRequestStatus @default(PENDING)
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PasswordToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
}

model Session {
  id        String   @id // случайный токен
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model ProtocolLog {
  id               Int      @id @default(autoincrement())
  user             User     @relation(fields: [userId], references: [id])
  userId           Int
  createdAt        DateTime @default(now())
  originalFilename String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
}

